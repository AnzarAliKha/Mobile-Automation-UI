{
  "name": "playwright-enterprise-automation-framework",
  "version": "1.0.0",
  "description": "Enterprise-ready Modern Web UI Automation Framework built with Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:regression": "playwright test --grep \"@regression\"",
    "test:e2e": "playwright test tests/checkout.spec.ts",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "page-object-model",
    "data-driven-testing",
    "e2e-testing"
  ],
  "author": "QA Automation Engineering",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "allure-playwright": "^3.2.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
